{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubFrontendProductionEnvironmentOnly",
      "Effect": "Allow",
      "Principal": { "Federated": "arn:aws:iam::919693204623:oidc-provider/token.actions.githubusercontent.com" },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:life-in-uk@337042510/frontend@1402385186:environment:production"
        }
      }
    }
  ]
}
